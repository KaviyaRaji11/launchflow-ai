# Server-side key for Campaign Brain and text generation; never use VITE_ prefix.
OPENROUTER_API_KEY=replace-with-your-server-side-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Optional image adapter only. The local image composition is the default.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# Local compositions need no paid image-generation credits.
VISUAL_PROVIDER=local

# Local development; use a persistent mounted path in production.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
